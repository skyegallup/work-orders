{
  "schemaVersion": 1,
  "id": "work_orders",
  "version": "${version}",
  "name": "Work Orders",
  "description": "A vanilla-style mod that adds limited-time villager trades.",
  "authors": [
    "Skylar G."
  ],
  "contact": {
    "homepage": "https://github.com/skyegallup/work-orders",
    "sources": "https://github.com/skyegallup/work-orders"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "gay.skyebound.work_orders.WorkOrdersMod"
    ],
    "client": [
      "gay.skyebound.work_orders.client.WorkOrdersModClient"
    ]
  },
  "mixins": [
    "work_orders.mixins.json",
    {
      "config": "work_orders.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "work_orders.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.20.4",
    "java": ">=17",
    "fabric-api": "*",
    "midnightlib": "~1.5.2-fabric"
  }
}